# ==============================================================================
# DeepLayer Solutions — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your credentials:
# cp .env.example .env.local
# ==============================================================================

# Supabase Production Database & Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Google Cloud Gmail API Transactional Email Configuration
# ==============================================================================
# Google Cloud OAuth 2.0 Client ID (Authorized for Gmail API)
GOOGLE_CLIENT_ID=197585439582-jh6f9bk079b3i5nb5pduag1ggc1ok949.apps.googleusercontent.com
# Google Cloud OAuth 2.0 Client Secret (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_SECRET=
# Google Cloud OAuth 2.0 Refresh Token (generated with scope https://www.googleapis.com/auth/gmail.send)
GOOGLE_REFRESH_TOKEN=
# Gmail user account email address
GMAIL_USER_EMAIL=deeplayersolutions@gmail.com
# Optional formatted sender name and address
GMAIL_SENDER_EMAIL=DeepLayer Solutions <deeplayersolutions@gmail.com>
# Primary company inbox for receiving inquiries and alerts
COMPANY_EMAIL=deeplayersolutions@gmail.com
# Redirect URI configured in Google Cloud OAuth Client
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# Public Production URL
NEXT_PUBLIC_SITE_URL=https://deeplayersolutions.vercel.app

# ==============================================================================
# Google Analytics 4 Configuration
# ==============================================================================
# Enter your GA4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
