# ==============================================================================
# DeepLayer Solutions — Supabase Environment Template
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase credentials:
# cp .env.example .env.local
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Resend Transactional Email Configuration
# ==============================================================================
RESEND_API_KEY=
COMPANY_EMAIL=deeplayersolutions@gmail.com
NEXT_PUBLIC_SITE_URL=https://deeplayersolutions.vercel.app
RESEND_FROM_EMAIL=DeepLayer Solutions <onboarding@resend.dev>

# ==============================================================================
# Google Analytics 4 Configuration
# ==============================================================================
# Enter your GA4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==============================================================================
# Cloudflare Turnstile Bot Protection
# ==============================================================================
# Testing keys (always pass):
# Site key: 1x00000000000000000000AA
# Secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
